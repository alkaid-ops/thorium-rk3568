diff --git a/media/gpu/sandbox/hardware_video_decoding_sandbox_hook_linux.cc b/media/gpu/sandbox/hardware_video_decoding_sandbox_hook_linux.cc
index 37f44c9813db7..80264ba1a406a 100644
--- a/media/gpu/sandbox/hardware_video_decoding_sandbox_hook_linux.cc
+++ b/media/gpu/sandbox/hardware_video_decoding_sandbox_hook_linux.cc
@@ -7,6 +7,7 @@
 #include <dlfcn.h>
 #include <sys/stat.h>
 
+#include "base/logging.h"
 #include "base/process/process_metrics.h"
 #include "base/strings/stringprintf.h"
 #include "build/build_config.h"
@@ -199,6 +200,24 @@ bool HardwareVideoDecodingPreSandboxHookForV4L2(
   static const char kDevImageProc0Path[] = "/dev/image-proc0";
   permissions.push_back(BrokerFilePermission::ReadWrite(kDevImageProc0Path));
 
+  // Linux ARM SoCs (for example Rockchip) expose the stateful/stateless
+  // decoder as a plain /dev/videoN node with a companion media controller
+  // device (/dev/mediaN or a named alias) instead of the ChromeOS
+  // video-dec/media-dec aliases above. Grant access to the generic nodes so
+  // the out-of-process decoder can enumerate and open them.
+  static constexpr size_t MAX_V4L2_GENERIC_DEVICES = 256;
+  static constexpr size_t MAX_MEDIA_CONTROLLER_DEVICES = 10;
+  for (size_t i = 0; i < MAX_V4L2_GENERIC_DEVICES; i++) {
+    std::ostringstream videoPath;
+    videoPath << kDevicePath << "video" << i;
+    permissions.push_back(BrokerFilePermission::ReadWrite(videoPath.str()));
+  }
+  for (size_t i = 0; i < MAX_MEDIA_CONTROLLER_DEVICES; i++) {
+    std::ostringstream mediaPath;
+    mediaPath << kDevicePath << "media" << i;
+    permissions.push_back(BrokerFilePermission::ReadWrite(mediaPath.str()));
+  }
+
   // Files needed for protected DMA allocations.
   static const char kDmaHeapPath[] = "/dev/dma_heap/restricted_mtk_cma";
   permissions.push_back(BrokerFilePermission::ReadWrite(kDmaHeapPath));
